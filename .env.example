# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: used to validate requests against your public site origin.
# Example: https://your-wedding-site.azurewebsites.net
APP_ORIGIN=

# Protects /status; keep both values server-side and never prefix them with NEXT_PUBLIC_.
# Use a unique password (12+ characters) and a random session secret (32+ bytes).
# Example session-secret generator: openssl rand -base64 32
RSVP_STATUS_PASSWORD=
RSVP_STATUS_SESSION_SECRET=
